{
  "name": "desktop-pet",
  "productName": "Desktop Pet",
  "version": "2.1.0",
  "private": true,
  "description": "A cat that lives on your desktop, plays with toys and keeps your copy-paste answers",
  "author": "lollinng",
  "homepage": "https://github.com/lollinng/mycat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/store.test.js tests/values.test.mjs tests/toys.test.mjs tests/sprite.test.mjs",
    "test:app": "node tests/app.e2e.mjs",
    "dist": "electron-builder --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.17.0",
    "playwright-core": "1.48.2"
  },
  "build": {
    "appId": "io.github.lollinng.desktoppet",
    "productName": "Desktop Pet",
    "copyright": "Code MIT; the cats keep their artists' terms (see README)",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "package.json",
      "pet/**",
      "panel/**",
      "assets/**",
      "!assets/icon-1024.png",
      "!assets/skins/white/**",
      "!assets/skins/kitten/**"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Desktop-Pet-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Desktop-Pet-${version}-portable.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Desktop-Pet-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "icon": "assets/icon-1024.png",
      "category": "Utility",
      "artifactName": "Desktop-Pet-${version}-linux-${arch}.${ext}"
    }
  }
}
